{
  "name": "gitlab-api-server",
  "version": "1.0.0",
  "description": "Express server for GitLab OAuth2 integration",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts"
  },
  "keywords": ["gitlab", "oauth2", "api"],
  "author": "",
  "license": "MIT",
  "dependencies": {
